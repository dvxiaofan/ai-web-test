{
  "name": "ai-web-test",
  "version": "0.1.0",
  "description": "Agent-friendly source, browser, and AI-assisted testing toolkit for existing web applications",
  "license": "MIT",
  "keywords": [
    "playwright",
    "testing",
    "ai",
    "e2e",
    "visual-regression"
  ],
  "type": "module",
  "private": true,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./discovery": {
      "types": "./dist/discovery/index.d.ts",
      "import": "./dist/discovery/index.js"
    },
    "./browser": {
      "types": "./dist/browser/index.d.ts",
      "import": "./dist/browser/index.js"
    },
    "./planning": {
      "types": "./dist/planning/index.d.ts",
      "import": "./dist/planning/index.js"
    },
    "./ai": {
      "types": "./dist/ai/index.d.ts",
      "import": "./dist/ai/index.js"
    }
  },
  "bin": {
    "aitest": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "aitest": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "baseline": "tsx scripts/save-baseline.ts",
    "clean": "node scripts/clean.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright": "^1.63.0",
    "typescript": "^5.8.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "tsx": "^4.23.15",
    "vitest": "^3.2.4"
  }
}
