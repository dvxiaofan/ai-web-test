# Dependencies
node_modules/

# Build and type-check output
dist/
coverage/
*.tsbuildinfo

# AI Web Test runtime artifacts (may contain URLs, screenshots, traces, and
# other target-project data; never commit these by default)
.ai-web-test/
.tmp-e2e-runs/
playwright-report/
blob-report/
test-results/
.playwright/
# Keep the explicit entries as documentation for nested/legacy workspaces.
.ai-web-test/auth/
.ai-web-test/.auth/
storage-state*.json

# Local-only verification files
tsconfig.check.json
tsconfig.build-check.json
vitest.check.config.mjs

# Local environment and credentials
.env
.env.*
!.env.example
# .nvmrc pins the Node version for reproducible installs; override the global
# gitignore rule that ignores it so the pin is version-controlled.
!.nvmrc
*.secret
*.secrets
*.pem
*.key
*.p12
*.pfx

# Tool caches and package artifacts
.cache/
.turbo/
.eslintcache
.npm/
*.tgz

# Logs and temporary files
*.log
*.tmp
*.temp

# Editors and operating systems
.DS_Store
.idea/
.vscode/

# Temporary exploration scripts (Phase 0 cleanup)
probe-*.mjs
